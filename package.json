{
  "name": "nozima-finance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/pets/nomoz/*.test.mjs src/pets/nomoz/spritesheet/*.test.mjs",
    "sheets:build": "node src/pets/nomoz/spritesheet/build.mjs sheets",
    "sheets:validate": "node src/pets/nomoz/spritesheet/validate.mjs --strict",
    "sheets:audit": "node src/pets/nomoz/spritesheet/audit.mjs --strict",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=240000 src/pets/nomoz/spritesheet/browser/*.browser.mjs",
    "verify": "npm test && npm run test:browser"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "1.63.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
